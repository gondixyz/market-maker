{
  "name": "gondi-market-maker",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Non-custodial market-making bot for NFT bids and listings on GONDI.",
  "main": "out/main/index.js",
  "scripts": {
    "start": "bun src/cli/index.ts",
    "lint": "bun run fmt-check && eslint . && tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt-check": "prettier --check .",
    "verify": "bun run lint && bun run test",
    "test": "bun test tests/",
    "dev:desktop": "electron-vite dev",
    "build:desktop": "electron-vite build",
    "package:desktop": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "gondi": "^0.54.0",
    "viem": "^2.55.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "3.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "8.3.7"
  },
  "packageManager": "bun@1.4.0"
}
